# REMAS Educational Center SaaS - Environment Variables Example Template
# Copy this file to .env and populate with actual credentials for local/staging/production environment.
# NEVER COMMIT REAL CRENDETIALS TO GIT!

# Environment Name: development | staging | production
NODE_ENV=development

# Firebase Configuration
FIREBASE_PROJECT_ID=FIREBASE_PROJECT_ID_PLACEHOLDER
FIREBASE_CLIENT_EMAIL=service-account@FIREBASE_PROJECT_ID_PLACEHOLDER.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPLACEHOLDER\n-----END PRIVATE KEY-----\n"

# Cloudflare Configuration
CLOUDFLARE_ACCOUNT_ID=CLOUDFLARE_ACCOUNT_ID_PLACEHOLDER
CLOUDFLARE_API_TOKEN=CLOUDFLARE_API_TOKEN_PLACEHOLDER

# Cloudflare R2 Media Storage
R2_BUCKET_NAME=remas-media-dev
R2_ACCESS_KEY_ID=R2_ACCESS_KEY_ID_PLACEHOLDER
R2_SECRET_ACCESS_KEY=R2_SECRET_ACCESS_KEY_PLACEHOLDER

# Auth & Token Configuration
JWT_ISSUER=https://securetoken.google.com/FIREBASE_PROJECT_ID_PLACEHOLDER
JWT_AUDIENCE=FIREBASE_PROJECT_ID_PLACEHOLDER

# FCM Configuration
FCM_SERVER_KEY=FCM_SERVER_KEY_PLACEHOLDER