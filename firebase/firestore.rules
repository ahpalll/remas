rules_version = '2';

/*
 * Educational Center SaaS - Firestore Security Rules (Phase 49.9.3 Master Security Specification - Zero-CLI Zero-Backend Owner Onboarding)
 * 1. Default Deny: All unmatched paths are strictly denied.
 * 2. Institution Document Rules: Immutable audit keys, tenant admin/superAdmin access, atomic owner claiming with getAfter().
 * 3. User Profile Rules: Whitelisted fields, zero physical delete, email_verified atomic creation.
 * 4. Invitation Rules: Base62 CSPRNG unguessable code, direct lookup only, atomic single-use claim with getAfter().
 */

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        (request.auth.token.keys().hasAny(['role']) && (request.auth.token.role == "superAdmin" || request.auth.token.role == "superadmin")) ||
        (request.auth.token.keys().hasAny(['superAdmin']) && request.auth.token.superAdmin == true)
      );
    }

    function isTenantOwner(institutionId) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/institutions/$(institutionId))
          && get(/databases/$(database)/documents/institutions/$(institutionId)).data.ownerId == request.auth.uid)
        ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "institutionOwner"
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.institutionId == institutionId)
      );
    }

    function isTenantAdmin(institutionId) {
      return isTenantOwner(institutionId) || isSuperAdmin();
    }

    function isTenantUser(institutionId) {
      return isTenantAdmin(institutionId);
    }

    function isSelf(userId, institutionId) {
      return isAuthenticated() && request.auth.uid == userId && (isTenantUser(institutionId) || isSuperAdmin());
    }

    // Phase 49.9.3 Institution Document Rules (Atomic Owner Claiming with getAfter)
    match /institutions/{institutionId} {
      allow read: if isTenantUser(institutionId) || isSuperAdmin();
      
      allow create: if isSuperAdmin()
        && request.resource.data.institutionId == institutionId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.status in ['ACTIVE', 'SUSPENDED', 'ARCHIVED'];

      // Allow Owner to claim center ONLY as part of valid atomic claim transaction
      allow update: if isSuperAdmin() || (
        isEmailVerified()
        && resource.data.ownerId == "PENDING_OWNER"
        && request.resource.data.ownerId == request.auth.uid
        && resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.ownerEmail == request.auth.token.email
        && resource.data.ownerInvitationCode == resource.data.ownerInvitationCode
        && request.resource.data.ownerInvitationCode == resource.data.ownerInvitationCode
        && exists(/databases/$(database)/documents/invitations/$(resource.data.ownerInvitationCode))
        && get(/databases/$(database)/documents/invitations/$(resource.data.ownerInvitationCode)).data.institutionId == institutionId
        && get(/databases/$(database)/documents/invitations/$(resource.data.ownerInvitationCode)).data.ownerEmail == request.auth.token.email
        && get(/databases/$(database)/documents/invitations/$(resource.data.ownerInvitationCode)).data.role == "institutionOwner"
        && get(/databases/$(database)/documents/invitations/$(resource.data.ownerInvitationCode)).data.status == "PENDING"
        && request.time < get(/databases/$(database)/documents/invitations/$(resource.data.ownerInvitationCode)).data.expiresAt
        && getAfter(/databases/$(database)/documents/invitations/$(resource.data.ownerInvitationCode)).data.status == "ACCEPTED"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId', 'updatedAt'])
      );

      allow delete: if isSuperAdmin();
    }

    // Phase 49.9.3 Invitations Collection Rules
    match /invitations/{invitationCode} {
      // Direct lookup ONLY by invitationCode document ID matching ownerEmail
      allow read: if isSuperAdmin() 
        || (isEmailVerified() 
            && request.auth.token.email == resource.data.ownerEmail 
            && resource.data.status == "PENDING" 
            && request.time < resource.data.expiresAt
            && resource.data.invitationCode == invitationCode);
      allow create: if isSuperAdmin();
      
      // Allow Owner to accept invitation ONLY as part of valid atomic claim transaction
      allow update: if isSuperAdmin() || (
        isEmailVerified()
        && resource.data.invitationCode == invitationCode
        && request.resource.data.invitationCode == invitationCode
        && resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.ownerEmail == request.auth.token.email
        && resource.data.role == "institutionOwner"
        && request.resource.data.role == "institutionOwner"
        && resource.data.status == "PENDING"
        && request.resource.data.status == "ACCEPTED"
        && request.time < resource.data.expiresAt
        && getAfter(/databases/$(database)/documents/institutions/$(resource.data.institutionId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/institutions/$(resource.data.institutionId)).data.ownerEmail == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt', 'acceptedBy', 'updatedAt'])
      );
      allow delete: if isSuperAdmin();
    }

    // Phase 49.9.3 Global Users Collection Rules
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      
      // Allow Owner to create own user document ONLY matching post-transaction institution owner state
      allow create: if isSuperAdmin() || (
        isEmailVerified()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "institutionOwner"
        && request.resource.data.status == "ACTIVE"
        && exists(/databases/$(database)/documents/institutions/$(request.resource.data.institutionId))
        && getAfter(/databases/$(database)/documents/institutions/$(request.resource.data.institutionId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/institutions/$(request.resource.data.institutionId)).data.ownerEmail == request.auth.token.email
      );

      // Owner CANNOT change role, institutionId, email, or uid
      allow update: if isSuperAdmin() || (
        isAuthenticated() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'institutionId', 'institutionIds', 'uid', 'email'])
      );
      allow delete: if isSuperAdmin();
    }

    // Phase 4 User Profile Rules (Subcollection)
    match /institutions/{institutionId}/users/{userId} {
      allow read: if isSelf(userId, institutionId) || isTenantAdmin(institutionId) || isSuperAdmin();
      allow create: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow update: if (isTenantAdmin(institutionId) || isSuperAdmin())
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'phone', 'updatedAt', 'updatedBy']);
      allow delete: if false;
    }

    // Phase 5 Server & Operational Collections
    match /institutions/{institutionId}/schedules/{scheduleId} {
      allow read: if isTenantUser(institutionId) || isSuperAdmin();
      allow create, update, delete: if isTenantAdmin(institutionId) || isSuperAdmin();
    }

    match /institutions/{institutionId}/groups/{groupId} {
      allow read: if isTenantUser(institutionId) || isSuperAdmin();
      allow create, update, delete: if isTenantAdmin(institutionId) || isSuperAdmin();
    }

    match /institutions/{institutionId}/academicYears/{yearId} {
      allow read: if isTenantUser(institutionId) || isSuperAdmin();
      allow create, update, delete: if isTenantAdmin(institutionId) || isSuperAdmin();
    }

    match /institutions/{institutionId}/terms/{termId} {
      allow read: if isTenantUser(institutionId) || isSuperAdmin();
      allow create, update, delete: if isTenantAdmin(institutionId) || isSuperAdmin();
    }

    match /institutions/{institutionId}/uniqueness/{uniqueKey} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if isTenantAdmin(institutionId) || isSuperAdmin();
    }

    match /institutions/{institutionId}/scheduleLocks/{lockKey} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if isTenantAdmin(institutionId) || isSuperAdmin();
    }

    // Phase 5 Client-Mutable Collections
    match /institutions/{institutionId}/subjects/{subjectId} {
      allow read: if isTenantUser(institutionId) || isSuperAdmin();
      allow create, update, delete: if isTenantAdmin(institutionId) || isSuperAdmin();
    }

    match /institutions/{institutionId}/stages/{stageId} {
      allow read: if isTenantUser(institutionId) || isSuperAdmin();
      allow create, update, delete: if isTenantAdmin(institutionId) || isSuperAdmin();
    }

    match /institutions/{institutionId}/rooms/{roomId} {
      allow read: if isTenantUser(institutionId) || isSuperAdmin();
      allow create, update, delete: if isTenantAdmin(institutionId) || isSuperAdmin();
    }

    match /institutions/{institutionId}/teachers/{teacherId} {
      allow read: if isTenantUser(institutionId) || isSuperAdmin() || (isAuthenticated() && request.auth.uid == resource.data.authUid);
      allow create: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow update: if (isTenantAdmin(institutionId) || isSuperAdmin())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['institutionId', 'role'])
        && (!resource.data.keys().hasAny(['authUid']) || request.resource.data.authUid == resource.data.authUid);
      allow delete: if isTenantAdmin(institutionId) || isSuperAdmin();
    }

    // Phase 6 Server-Only Collections
    match /institutions/{institutionId}/enrollments/{enrollmentId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if isTenantAdmin(institutionId) || isSuperAdmin();
    }

    match /institutions/{institutionId}/guardians/{guardianId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if isTenantAdmin(institutionId) || isSuperAdmin();
    }

    match /institutions/{institutionId}/studentGuardians/{relationshipId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if isTenantAdmin(institutionId) || isSuperAdmin();
    }

    match /institutions/{institutionId}/groupCounters/{groupId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if isTenantAdmin(institutionId) || isSuperAdmin();
    }

    // Collection Group rule for Student Profile lookup & post-OTP context resolution
    match /{path=**}/students/{studentId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.authUid && resource.data.status == 'ACTIVE');
    }

    // Phase 6 Operational Collection — Students
    match /institutions/{institutionId}/students/{studentId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin() 
        || (isAuthenticated() && request.auth.uid == resource.data.authUid && resource.data.status == 'ACTIVE')
        || (isAuthenticated() && (resource.data.parentUid == request.auth.uid || (resource.data.keys().hasAny(['guardianUids']) && resource.data.guardianUids.hasAny([request.auth.uid]))));
      allow create: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow update: if (isTenantAdmin(institutionId) || isSuperAdmin())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['institutionId', 'role'])
        && (!resource.data.keys().hasAny(['authUid']) || request.resource.data.authUid == resource.data.authUid);
      allow delete: if isTenantAdmin(institutionId) || isSuperAdmin();
    }

    // Phase 7 Attendance System Collections
    match /institutions/{institutionId}/attendanceSessions/{sessionId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if isTenantAdmin(institutionId) || isSuperAdmin();

      match /records/{studentId} {
        allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
        allow create, update, delete: if isTenantAdmin(institutionId) || isSuperAdmin();
      }
    }

    match /institutions/{institutionId}/attendanceCorrections/{correctionId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if isTenantAdmin(institutionId) || isSuperAdmin();
    }

    match /institutions/{institutionId}/attendanceAudits/{auditId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if isTenantAdmin(institutionId) || isSuperAdmin();
    }

    match /institutions/{institutionId}/attendanceAggregates/{aggregateId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if isTenantAdmin(institutionId) || isSuperAdmin();
    }

    // Phase 8 Finance System Operational Collections
    match /institutions/{institutionId}/feeStructures/{feeStructureId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if isTenantAdmin(institutionId) || isSuperAdmin();
    }

    match /institutions/{institutionId}/studentCharges/{chargeId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if isTenantAdmin(institutionId) || isSuperAdmin();
    }

    match /institutions/{institutionId}/studentPayments/{paymentId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if isTenantAdmin(institutionId) || isSuperAdmin();
    }

    match /institutions/{institutionId}/receipts/{receiptId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if isTenantAdmin(institutionId) || isSuperAdmin();
    }

    match /institutions/{institutionId}/financialRefunds/{refundId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if isTenantAdmin(institutionId) || isSuperAdmin();
    }

    match /institutions/{institutionId}/expenses/{expenseId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if isTenantAdmin(institutionId) || isSuperAdmin();
    }

    match /institutions/{institutionId}/otherIncome/{incomeId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if isTenantAdmin(institutionId) || isSuperAdmin();
    }

    match /institutions/{institutionId}/teacherSettlements/{settlementId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /institutions/{institutionId}/cashboxPeriods/{periodId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /institutions/{institutionId}/financialLedger/{ledgerId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /institutions/{institutionId}/financialCorrections/{correctionId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /institutions/{institutionId}/financialAudits/{auditId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /institutions/{institutionId}/financialAggregates/{aggregateId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    // Phase 9 Books & Inventory Server-Only Collections
    match /institutions/{institutionId}/books/{bookId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /institutions/{institutionId}/suppliers/{supplierId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /institutions/{institutionId}/purchases/{purchaseId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /institutions/{institutionId}/purchaseLines/{lineId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /institutions/{institutionId}/sales/{saleId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /institutions/{institutionId}/saleLines/{lineId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /institutions/{institutionId}/studentDeliveries/{deliveryId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /institutions/{institutionId}/returns/{returnId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /institutions/{institutionId}/stockMovements/{movementId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /institutions/{institutionId}/inventory/{bookId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /institutions/{institutionId}/inventoryLocks/{lockId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    // Phase 10 Exams & Grades Server-Only Collections
    match /institutions/{institutionId}/questionBanks/{bankId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /institutions/{institutionId}/questions/{questionId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /institutions/{institutionId}/questionOptions/{optionId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /institutions/{institutionId}/exams/{examId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /institutions/{institutionId}/examQuestions/{examQuestionId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /institutions/{institutionId}/grades/{gradeId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /institutions/{institutionId}/gradeRevisions/{revisionId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /institutions/{institutionId}/examLocks/{lockId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    // Phase 11 Online Exams Runtime Collections
    match /institutions/{institutionId}/examAttempts/{attemptId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin()
        || (isTenantUser(institutionId) && request.auth.uid == resource.data.studentId);
      allow create, update, delete: if false;

      match /questions/{questionId} {
        allow read: if isTenantAdmin(institutionId) || isSuperAdmin()
          || (isTenantUser(institutionId) && request.auth.uid == get(/databases/$(database)/documents/institutions/$(institutionId)/examAttempts/$(attemptId)).data.studentId);
        allow create, update, delete: if false;
      }

      match /answers/{questionId} {
        allow read: if isTenantAdmin(institutionId) || isSuperAdmin()
          || (isTenantUser(institutionId) && request.auth.uid == get(/databases/$(database)/documents/institutions/$(institutionId)/examAttempts/$(attemptId)).data.studentId);
        allow create, update, delete: if false;
      }
    }

    // Phase 12 Educational Content Management Collections (Direct Client Writes DENIED)
    match /institutions/{institutionId}/lessons/{lessonId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /institutions/{institutionId}/contents/{contentId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    // Phase 14 Subscription Codes & Content Entitlements Collections (Direct Client Writes DENIED)
    match /institutions/{institutionId}/packages/{packageId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /institutions/{institutionId}/subscriptionCodes/{codeId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /institutions/{institutionId}/entitlements/{entitlementId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin()
        || (isTenantUser(institutionId) && request.auth.uid == resource.data.studentId);
      allow create, update, delete: if false;
    }

    // Phase 21 System Health & System Metadata Collections (Direct Client Writes DENIED)
    match /systemHealth/{checkId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /systemMetadata/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    // Phase 40 Production Identity, License & Single Device Binding Rules
    match /licenses/{licenseId} {
      allow read: if isAuthenticated() && (isTenantUser(resource.data.institutionId) || isSuperAdmin());
      allow create, update, delete: if isSuperAdmin();
    }

    match /deviceBindings/{bindingId} {
      allow read: if isAuthenticated() && (isTenantUser(resource.data.institutionId) || isSuperAdmin());
      allow create, update, delete: if isSuperAdmin();
    }
  }
}