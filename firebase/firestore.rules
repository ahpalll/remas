rules_version = '2';

/*
 * Educational Center SaaS - Firestore Security Rules (Phase 2 Auth & Least Privilege)
 * 1. Default Deny: All unmatched paths are strictly denied.
 * 2. Identity Verification: Users can read ONLY their own user profile document.
 * 3. Tenant Isolation: Institution Admins can access profiles strictly within their institution.
 * 4. Super Admin: Global platform read/write access.
 * 5. No Root Wildcard / No Public Access.
 */

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == "superAdmin";
    }

    function isTenantAdmin(institutionId) {
      return isAuthenticated() 
        && request.auth.token.institutionId == institutionId 
        && request.auth.token.role in ["institutionOwner", "admin"];
    }

    function isTenantUser(institutionId) {
      return isAuthenticated() && request.auth.token.institutionId == institutionId;
    }

    // User Profile Rules (Least Privilege)
    match /institutions/{institutionId}/users/{userId} {
      // User can read ONLY their own document, or tenant admin can read within tenant scope, or super admin globally
      allow read: if isSelf(userId) || isTenantAdmin(institutionId) || isSuperAdmin();
      
      // Writes allowed strictly by tenant admins or super admins
      allow write: if isTenantAdmin(institutionId) || isSuperAdmin();
    }
  }
}