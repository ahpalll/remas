rules_version = '2';

/*
 * Educational Center SaaS - Firestore Security Rules (Phase 4 User & Identity Management - Hardened)
 * 1. Default Deny: All unmatched paths are strictly denied.
 * 2. Institution Document Rules (Phase 3):
 *    - Document ID MUST equal institutionId field.
 *    - institutionId, id, ownerId, createdBy, and createdAt are strictly IMMUTABLE post-creation for ALL roles (including superAdmin).
 *    - createdBy MUST equal request.auth.uid on creation.
 *    - updatedBy MUST equal request.auth.uid on update.
 *    - Read: Tenant users of that institution or Super Admin.
 *    - Update: Tenant admins of that institution or Super Admin (with updatedBy check and immutable audit key protections).
 *    - Create / Delete: Super Admin only (with structural validation).
 * 3. User Profile Rules (Phase 4):
 *    - Read: Self profile read within tenant boundary, or Tenant Admin within tenant scope, or Super Admin globally.
 *    - Create: DENIED to clients (allow create: if false). User creation occurs exclusively via trusted Admin SDK endpoint.
 *    - Delete: DENIED to clients (allow delete: if false). Termination uses soft-deletion (status = 'ARCHIVED').
 *    - Update: Allowed ONLY for tenant admins within tenant scope or Super Admin globally.
 *      Requires updatedBy == request.auth.uid and updatedAt == request.time.
 *      Strictly Whitelisted mutable fields ONLY: ['fullName', 'phone', 'updatedAt', 'updatedBy'].
 * 4. No Root Wildcard / No Public Access / No Unsafe Client Bypasses.
 */

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == "superAdmin";
    }

    function isTenantUser(institutionId) {
      return isAuthenticated() && request.auth.token.institutionId == institutionId;
    }

    function isSelf(userId, institutionId) {
      return isAuthenticated() && request.auth.uid == userId && (isTenantUser(institutionId) || isSuperAdmin());
    }

    function isTenantAdmin(institutionId) {
      return isTenantUser(institutionId) 
        && request.auth.token.role in ["institutionOwner", "admin"];
    }

    // Phase 3 Institution Document Rules
    match /institutions/{institutionId} {
      allow read: if isTenantUser(institutionId) || isSuperAdmin();
      
      allow create: if isSuperAdmin()
        && request.resource.data.institutionId == institutionId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.status in ['ACTIVE', 'SUSPENDED', 'ARCHIVED'];

      allow update: if (isTenantAdmin(institutionId) || isSuperAdmin())
        && request.resource.data.updatedBy == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['institutionId', 'id', 'ownerId', 'createdBy', 'createdAt']);

      allow delete: if isSuperAdmin();
    }

    // Phase 4 User Profile Rules (Hardened Field Whitelist, Zero Physical Delete, request.time Check)
    match /institutions/{institutionId}/users/{userId} {
      allow read: if isSelf(userId, institutionId) || isTenantAdmin(institutionId) || isSuperAdmin();
      
      // Client direct user creation DENIED
      allow create: if false;

      // Client updates allowed only for tenant admins within tenant scope; Whitelisted fields & request.time check
      allow update: if (isTenantAdmin(institutionId) || isSuperAdmin())
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'phone', 'updatedAt', 'updatedBy']);
      
      // Physical deletion DENIED; termination strictly uses soft-deletion (status = 'ARCHIVED')
      allow delete: if false;
    }
  }
}