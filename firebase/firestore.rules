rules_version = '2';

/*
 * Educational Center SaaS - Firestore Security Rules (Phase 5 Academic Core Foundation - Hardened)
 * 1. Default Deny: All unmatched paths are strictly denied.
 * 2. Institution Document Rules (Phase 3): Immutable audit keys, tenant admin/superAdmin access.
 * 3. User Profile Rules (Phase 4): Whitelisted fields, zero physical delete, request.time check.
 * 4. Academic Core Rules (Phase 5):
 *    - Server-Only Collections (schedules, groups, academicYears, terms, uniqueness, scheduleLocks):
 *      Client direct create/update/delete DENIED (allow create, update, delete: if false).
 *    - Client-Mutable Collections (subjects, stages, rooms, teachers):
 *      Client updates allowed ONLY for tenant admins/superAdmin with strict field whitelists & request.time check.
 *    - Student / Parent Broad Read DENIED across all Academic Core collections.
 */

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == "superAdmin";
    }

    function isTenantUser(institutionId) {
      return isAuthenticated() && request.auth.token.institutionId == institutionId;
    }

    function isSelf(userId, institutionId) {
      return isAuthenticated() && request.auth.uid == userId && (isTenantUser(institutionId) || isSuperAdmin());
    }

    function isTenantAdmin(institutionId) {
      return isTenantUser(institutionId) 
        && request.auth.token.role in ["institutionOwner", "admin"];
    }

    // Phase 3 Institution Document Rules
    match /institutions/{institutionId} {
      allow read: if isTenantUser(institutionId) || isSuperAdmin();
      
      allow create: if isSuperAdmin()
        && request.resource.data.institutionId == institutionId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.status in ['ACTIVE', 'SUSPENDED', 'ARCHIVED'];

      allow update: if (isTenantAdmin(institutionId) || isSuperAdmin())
        && request.resource.data.updatedBy == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['institutionId', 'id', 'ownerId', 'createdBy', 'createdAt']);

      allow delete: if isSuperAdmin();
    }

    // Phase 4 User Profile Rules
    match /institutions/{institutionId}/users/{userId} {
      allow read: if isSelf(userId, institutionId) || isTenantAdmin(institutionId) || isSuperAdmin();
      
      allow create: if false;

      allow update: if (isTenantAdmin(institutionId) || isSuperAdmin())
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'phone', 'updatedAt', 'updatedBy']);
      
      allow delete: if false;
    }

    // Phase 5 Server-Only Collections (Direct Client Writes & Student/Parent Broad Reads DENIED)
    match /institutions/{institutionId}/schedules/{scheduleId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /institutions/{institutionId}/groups/{groupId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /institutions/{institutionId}/academicYears/{yearId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /institutions/{institutionId}/terms/{termId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /institutions/{institutionId}/uniqueness/{uniqueKey} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /institutions/{institutionId}/scheduleLocks/{lockKey} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    // Phase 5 Client-Mutable Collections (Strict Field Whitelists, Server Timestamp, Student/Parent Read DENIED)
    match /institutions/{institutionId}/subjects/{subjectId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create: if (isTenantAdmin(institutionId) || isSuperAdmin())
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if (isTenantAdmin(institutionId) || isSuperAdmin())
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'code', 'description', 'status', 'updatedAt', 'updatedBy']);
      allow delete: if false;
    }

    match /institutions/{institutionId}/stages/{stageId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create: if (isTenantAdmin(institutionId) || isSuperAdmin())
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if (isTenantAdmin(institutionId) || isSuperAdmin())
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'code', 'order', 'status', 'updatedAt', 'updatedBy']);
      allow delete: if false;
    }

    match /institutions/{institutionId}/rooms/{roomId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create: if (isTenantAdmin(institutionId) || isSuperAdmin())
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if (isTenantAdmin(institutionId) || isSuperAdmin())
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'capacity', 'location', 'status', 'updatedAt', 'updatedBy']);
      allow delete: if false;
    }

    match /institutions/{institutionId}/teachers/{teacherId} {
      allow read: if isTenantAdmin(institutionId) || isSuperAdmin();
      allow create: if (isTenantAdmin(institutionId) || isSuperAdmin())
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if (isTenantAdmin(institutionId) || isSuperAdmin())
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'phone', 'email', 'specialization', 'subjectIds', 'status', 'updatedAt', 'updatedBy']);
      allow delete: if false;
    }
  }
}