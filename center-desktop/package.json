{
  "name": "remas-center-desktop",
  "version": "1.0.0-release.47.0",
  "description": "REMAS Educational Center SaaS — Standalone Windows Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "npx electron-builder --win nsis"
  },
  "keywords": [
    "remas",
    "windows",
    "desktop",
    "saas",
    "education-center",
    "single-device-licensing"
  ],
  "author": "REMAS SaaS Team",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "firebase": "^10.14.1"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.remas.centerdesktop",
    "productName": "remas-center-desktop",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "${productName} Setup ${version}.${ext}"
    }
  }
}
